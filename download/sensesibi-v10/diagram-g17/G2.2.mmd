    classDef proses fill:#dcfce7,stroke:#16a34a,stroke-width:2px,color:#14532d
    class CAM,GURU,LAB guru
    class CSI,PRE,ADP,ENC,EMT,HCL,HRG,KLS,KPT model
    class PAIR,LTOT,EDGE proses
